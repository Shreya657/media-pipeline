generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String         @id
  email         String         @unique
  createdAt     DateTime       @default(now())
  imageUrl      String?
  updatedAt     DateTime       @updatedAt
  username      String?        @unique
  notifications Notification[]
  uploads       Upload[]
}

model Upload {
  id             String         @id @default(uuid())
  userId         String
  createdAt      DateTime       @default(now())
  failReason     String?
  mediaType      MediaType
  originalName   String
  originalUrl    String
  outputUrls     Json?
  processingOpts Json
  progress       Int            @default(0)
  updatedAt      DateTime       @updatedAt
  status         UploadStatus   @default(PENDING)
  notifications  Notification[]
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  uploadId  String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  upload    Upload   @relation(fields: [uploadId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  number     Int
}

enum UploadStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}


enum MediaType {
  IMAGE
  VIDEO
}
